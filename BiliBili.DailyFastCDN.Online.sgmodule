#!name=📺 BiliBili: 每日最快 CDN
#!desc=当天首次 JSON PlayURL 时，实测官方下发的播放源并优先最快项；不是 App 启动事件。
#!category=📺 BiliBili
#!arguments=SAMPLEBYTES=524288&HTTPTIMEOUT=4&MAXCANDIDATES=4&POLICY=__PROFILE_RULES__&NOTIFY=false
#!arguments-desc=SAMPLEBYTES: 每个候选下载的 Range 字节数（65536-2097152）\nHTTPTIMEOUT: 每个候选的超时秒数（1-10）\nMAXCANDIDATES: 并发候选数（2-6）\nPOLICY: 测速使用的已有 Surge 策略；保留默认值则遵循现有规则\nNOTIFY: true 时显示每日测速结果

[General]
force-http-engine-hosts = %INSERT% api.bilibili.com:443, api.biliapi.net:443, app.bilibili.com:443

[Script]
BiliBili.DailyFastCDN.PlayURL = type=http-response,pattern=^https?:\/\/(?:api\.bili(?:bili\.com|api\.net)|app\.bilibili\.com)\/(?:x\/player\/(?:wbi\/)?playurl|pgc\/player\/(?:api|web)(?:\/v2)?\/playurl)(?:\?|$),requires-body=true,max-size=524288,timeout=15,script-path=https://raw.githubusercontent.com/lafant/SurgeModule/main/bilibili-daily-fast-cdn.js,script-update-interval=86400,argument=mode=playurl&sample_bytes=%SAMPLEBYTES%&http_timeout=%HTTPTIMEOUT%&max_candidates=%MAXCANDIDATES%&policy=%POLICY%&notify=%NOTIFY%

[MITM]
hostname = %INSERT% api.bilibili.com, api.biliapi.net, app.bilibili.com
tcp-connection = true
